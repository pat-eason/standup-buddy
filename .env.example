# Copy to .env. Everything has a working default except the model provider:
# either an API key (here or in the app under Settings), or your Claude Code
# subscription (Settings → Model provider → Set up Claude Code subscription).
ANTHROPIC_API_KEY=
APP_SECRET=change-me-to-a-long-random-string
INTERNAL_TOKEN=change-me-too
POSTGRES_PASSWORD=standup
WEB_PORT=8080
# Your IANA time zone, so the MCP server's "today" matches the UI.
TZ=UTC
# Optional: require "Authorization: Bearer <token>" on /mcp.
MCP_TOKEN=
