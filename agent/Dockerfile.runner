# Claude Code runner: runs the agents on the user's Claude Code subscription.
# The login is created from Settings and stored in the volume mounted at /home/node.
FROM node:24-slim
ENV NODE_ENV=production HOME=/home/node SUBSCRIPTION_HOST=0.0.0.0 SUBSCRIPTION_PORT=3100
RUN mkdir -p /app /home/node/.claude && chown -R node:node /app /home/node
USER node
WORKDIR /app
COPY --chown=node:node package.json package-lock.json ./
# `npm install`, not `npm ci`: the lock file lacks some platform-specific optional packages.
# The musl build of the Claude binary is never used on this glibc image.
RUN npm install --omit=dev --no-audit --no-fund \
 && rm -rf node_modules/@anthropic-ai/claude-agent-sdk-*-musl \
 && npm cache clean --force
COPY --chown=node:node src ./src
EXPOSE 3100
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD node -e "fetch('http://127.0.0.1:3100/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "src/claude-code/server.ts"]
